# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_guild_id_here

# Local AI (Ollama / LM Studio / llama.cpp)
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=llama3.2

# Discord Channel IDs
TARGET_CHANNEL_ID=1234567890          # Channel to monitor for chat messages
DAILY_JOBS_CHANNEL_ID=1234567890      # Channel for job search reports
STATUS_CHANNEL_ID=1234567890          # Voice channel for status display
NOTIFICATION_CHANNEL_ID=1234567890    # Voice channel for notification status
REMINDER_CHANNEL_ID=1234567890        # Channel for session/activity reminders
